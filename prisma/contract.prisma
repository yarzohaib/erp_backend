// use prisma-8
model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String?

  firstName  String
  lastName   String?
  companyName String?
  avatarUrl  String?

  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts       OAuthAccount[]
  oauthLoginCodes     OAuthLoginCode[]
  signatures          Signature[]
  team                Team?
  settings            UserSettings?
}

model Session {
  id               String    @id @default(uuid())
  userId           String

  refreshTokenHash String    @unique

  userAgent        String?
  ipAddress        String?
  deviceName       String?

  expiresAt        DateTime
  revokedAt        DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String

  tokenHash String   @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String

  provider          String
  providerAccountId String
  email             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OAuthLoginCode {
  id        String    @id @default(uuid())
  userId    String

  codeHash  String    @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String

  tokenHash String    @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Signature {
  id              String   @id @default(uuid())
  userId          String

  name            String
  templateId      String
  templateVersion Int      @default(1)
  data            Json

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Team {
  id              String       @id @default(uuid())
  ownerId         String       @unique
  name            String
  kind            String
  templateId      String
  templateVersion Int          @default(1)
  data            Json
  memberLimit     Int          @default(3)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now())

  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
}

model TeamMember {
  id             String    @id @default(uuid())
  teamId         String
  name           String
  email          String
  jobTitle       String    @default("")
  phone          String    @default("")
  photoUrl       String    @default("")
  socials        Json?
  status         String    @default("draft")
  tokenHash      String?   @unique
  tokenExpiresAt DateTime?
  sentAt         DateTime?
  acceptedAt     DateTime?
  sendCount      Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())

  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([teamId])
}

model UserSettings {
  userId               String    @id
  defaultTemplateId    String?
  defaultExportFormat  String    @default("html")
  signatureFont        String    @default("Arimo")
  brandColor           String    @default("#245FD4")
  includePhoto         Boolean   @default(true)
  notifyProductUpdates Boolean   @default(true)
  notifyTips           Boolean   @default(false)
  premiumWaitlistAt    DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}