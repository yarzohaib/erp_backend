NODE_ENV=development
PORT=8000

APP_NAME=SigSignature API
APP_URL=https://api.sigsignature.com
BACKEND_URL=https://api.sigsignature.com
FRONTEND_URL=https://www.sigsignature.com
TRUST_PROXY_HOPS=1
# Optional Cloudflare Turnstile Secret Key (enables captcha verification after 5 failed login attempts)
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS S3 Storage & Region
# The default AWS SDK credential provider chain is used (EC2 IAM instance profile role in production, AWS CLI / env vars in local development)
AWS_REGION=ap-southeast-2
# S3 bucket name for avatar and logo uploads
S3_BUCKET=your-sigsignature-uploads-bucket
# Public CDN or S3 base URL for serving uploaded assets (e.g., https://cdn.sigsignature.com or https://your-bucket.s3.ap-southeast-2.amazonaws.com)
S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-southeast-2.amazonaws.com

# Signature plan limits
# Maximum number of email signatures an individual user can create or duplicate
SIGNATURE_LIMIT_PER_USER=3

# Team Signatures limits
# Maximum number of team members allowed on the free plan
TEAM_MEMBER_LIMIT_FREE=3
# Invite link expiration in days
TEAM_INVITE_TTL_DAYS=14
# Maximum invite sends across the team in a rolling 24-hour window
TEAM_SEND_DAILY_LIMIT=10
# Maximum invite sends allowed per individual team member
TEAM_SEND_MAX_PER_MEMBER=5
# Minimum cooldown period in seconds between invite sends to the same member
TEAM_SEND_COOLDOWN_SECONDS=60