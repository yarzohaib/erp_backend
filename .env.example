NODE_ENV=development
PORT=8000

APP_NAME=ERP Backend
APP_URL=http://localhost:8000
BACKEND_URL=
FRONTEND_URL=

DATABASE_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS S3 Storage & Region
# The default AWS SDK credential provider chain is used (EC2 IAM instance profile role in production, AWS CLI / env vars in local development)
AWS_REGION=ap-southeast-2
# S3 bucket name for avatar and logo uploads
S3_BUCKET=your-sigsignature-uploads-bucket
# Public CDN or S3 base URL for serving uploaded assets (e.g., https://cdn.sigsignature.com or https://your-bucket.s3.ap-southeast-2.amazonaws.com)
S3_PUBLIC_BASE_URL=https://your-bucket.s3.ap-southeast-2.amazonaws.com

# Signature plan limits
# Maximum number of email signatures an individual user can create or duplicate
SIGNATURE_LIMIT_PER_USER=3